# Hacker gf — local/Vercel environment template
# Copy to .env.local for local development. Do not commit real secret values.

# Vite build-time public settings (these values are visible in the browser bundle).
# Required for Base44-backed entity/integration features. Obtain from Base44 app settings.
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=

# Public Supabase client config; publishable/anon key only, never service_role.
VITE_SUPABASE_URL=https://iausxfvlhqtlcoaovoiv.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-only Vercel Function config (do not prefix these with VITE_).
# The backend uses the same public Supabase project to validate authenticated sessions.
SUPABASE_URL=https://iausxfvlhqtlcoaovoiv.supabase.co
SUPABASE_ANON_KEY=
OPENROUTER_API_KEY=
PUBLIC_APP_URL=https://hackergf.devs.surf

# Required in Vercel Production for shared rate limiting and the monthly Free-plan quota; optional for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
